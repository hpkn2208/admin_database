# Copy this file to .streamlit/secrets.toml and fill in real values.
# Local-only app — never deploy this to Streamlit Cloud or any public host,
# it has permanent delete access to the shared feedback table + R2 images.
#
# Same Supabase project + R2 bucket as streamlit_app / streamlit_case_app —
# copy postgres_url and the [r2] block from streamlit_app/.streamlit/secrets.toml.
# admin_username / admin_password are new: pick your own, they only gate this
# app's login screen.

postgres_url = "postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

admin_username = "choose-a-username"
admin_password = "choose-a-password"

[r2]
account_id = "your-cloudflare-account-id"
access_key_id = "your-r2-access-key-id"
secret_access_key = "your-r2-secret-access-key"
bucket = "lichen-images"
